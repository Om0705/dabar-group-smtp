PORT=8080

# Comma-separated browser origins allowed to call this API (CORS). If unset, defaults include localhost:5173 and dabargroup.com.
# On Render, add your static site URL if it is not dabargroup.com, e.g. https://dabar-group.onrender.com
# ALLOWED_ORIGINS=https://dabargroup.com,https://www.dabargroup.com,http://localhost:5173

# Use the SMTP hostname from your email provider (must match the TLS certificate).
# If you see "x509: certificate signed by unknown authority", try the provider's generic host (e.g. smtp.hostinger.com) instead of mail.yourdomain.com.
SMTP_HOST=mail.dabargroup.com

# Optional. Default 465 + implicit TLS. Many hosts also support 587 + STARTTLS:
# SMTP_PORT=587
# SMTP_SSL=false

SMTP_USER=info@dabargroup.com
SMTP_PASS=your_smtp_password_here